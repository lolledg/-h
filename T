-- Script de verificación para physicreprotate y sethidenpropietary

local function verificarEntorno()
    print("--------------------------------------------------")
    print("[*] Iniciando diagnóstico de funciones...")
    print("--------------------------------------------------")

    -- 1. Verificación de sethidenpropietary / sethiddenproperty
    local funcionOculta = nil
    
    if type(sethidenpropietary) == "function" then
        funcionOculta = sethidenpropietary
    elseif type(sethiddenproperty) == "function" then
        funcionOculta = sethiddenproperty
    elseif getgenv then
        if type(getgenv().sethidenpropietary) == "function" then
            funcionOculta = getgenv().sethidenpropietary
        elseif type(getgenv().sethiddenproperty) == "function" then
            funcionOculta = getgenv().sethiddenproperty
        end
    end

    if funcionOculta then
        print("[✔] ESTADO: 'sethidenpropietary' / 'sethiddenproperty' está ACTIVO y disponible.")
    else
        print("[✖] ESTADO: 'sethidenpropietary' NO se encuentra en el entorno global.")
    end

    -- 2. Verificación de physicreprotate
    local estadoPhysicsRotate = false
    
    if physicreprotate ~= nil then
        estadoPhysicsRotate = true
    elseif getgenv and getgenv().physicreprotate ~= nil then
        estadoPhysicsRotate = true
    elseif _G.physicreprotate ~= nil then
        estadoPhysicsRotate = true
    end

    if estadoPhysicsRotate then
        print("[✔] ESTADO: 'physicreprotate' está DEFINIDO / ACTIVO.")
    else
        print("[✖] ESTADO: 'physicreprotate' NO se encuentra detectado.")
    end

    print("--------------------------------------------------")
end

-- Ejecutar la verificación de manera segura
task.spawn(verificarEntorno)
