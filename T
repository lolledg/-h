-- 1. Espiar sethiddenproperty
local old_sethiddenproperty
old_sethiddenproperty = hookfunction(sethiddenproperty, function(obj, prop, val)
    if tostring(prop) == "NetworkOwnershipRule" or tostring(prop) == "NetworkOwner" then
        print("[🔧 sethiddenproperty] Alterando NetworkOwner en:", tostring(obj))
    end
    return old_sethiddenproperty(obj, prop, val)
end)

