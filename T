-- 3. Espiar qué objetos (Instancias) está creando el script
local old_instancenew
old_instancenew = hookfunction(Instance.new, function(className, parent)
    -- Filtramos solo las instancias usadas para "attachar" cosas
    if className == "AlignPosition" or className == "AlignOrientation" or className == "Weld" or className == "Motor6D" or className == "Attachment" then
        print(string.format("[🏗️ Instance.new] Creando Constraint de Attach: %s | Padre: %s", className, tostring(parent)))
    end
    return old_instancenew(className, parent)
end)

-- 4. Espiar metamétodos (__namecall) para interceptar SetNetworkOwner y BreakJoints
local old_namecall
old_namecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if method == "SetNetworkOwner" then
        print(string.format("[🌐 SetNetworkOwner] Objeto: %s | Reclamando control de físicas", tostring(self)))
    elseif method == "BreakJoints" then
        print(string.format("[💥 BreakJoints] Rompiendo uniones de: %s (Común en reanimaciones)", tostring(self)))
    end

    return old_namecall(self, ...)
end)

