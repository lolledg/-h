-- Verificamos que tu executor soporte hookfunction
if not hookfunction then
    warn("Tu executor no soporta hookfunction, no se puede interceptar sethiddenproperty.")
    return
end

-- Creamos el hook
local old_sethiddenproperty
old_sethiddenproperty = hookfunction(sethiddenproperty, function(obj, prop, val)
    -- Imprimimos usando tostring() para evitar errores si el objeto o valor es nil o una tabla rara
    print("\n[⚠️ sethiddenproperty DETECTADO]")
    print("  Objeto:", tostring(obj))
    print("  Clase del Objeto:", typeof(obj) == "Instance" and obj.ClassName or typeof(obj))
    print("  Propiedad:", tostring(prop))
    print("  Valor:", tostring(val))
    print("---------------------------------")

    -- Retornamos la función original para que el juego siga funcionando con normalidad
    return old_sethiddenproperty(obj, prop, val)
end)

print("✅ Hook de sethiddenproperty activado correctamente.")
